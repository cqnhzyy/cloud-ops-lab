# 复制为 terraform.tfvars 并填入真实值
# terraform.tfvars 已在 .gitignore 中，不会被提交

region             = "cn-south-1"
instance_name      = "my-web-server-from-tf"
availability_zone  = "cn-south-1a"
flavor_id          = "s6.small.1"

image_id           = "填入你的镜像ID"
vpc_network_id     = "填入你的VPC子网ID"

# 收紧到自己的公网出口 IP，例如 "203.0.113.10/32"
ssh_allowed_cidr   = "填入你的办公网段/32"

# 建议改用环境变量 TF_VAR_admin_pass 注入，不要落盘
admin_pass         = "填入你的密码"
